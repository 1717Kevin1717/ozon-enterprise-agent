# 本地开发默认使用 SQLite；Docker Compose 中请改为 PostgreSQL 连接串。
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/zmt_enterprise.db
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=chrome-extension://*,http://127.0.0.1:8000,http://localhost:8000
DEFAULT_COMPANY_ID=local-zmt
DEFAULT_USER_ID=local-operator
DEFAULT_ROLE=company_admin
MAX_CAPTURE_BYTES=2097152
# disabled=纯确定性；dual=Qwen 语义理解 + 按需 DeepSeek 推理；zhipu=旧链路兼容。
# 无论选择哪个模型，工具执行、业务事实、计算、门禁和审批仍由本后台控制。
LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=
# 双模型路由。密钥只写入本机 .env；不要提交。
PRIMARY_LLM_PROVIDER=qwen
PRIMARY_LLM_MODEL=qwen3.5-plus
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
REASONING_LLM_PROVIDER=deepseek
REASONING_LLM_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
PROVIDER_TIMEOUT_SECONDS=30
# disabled / mock_only / anonymized；默认不把后端业务数值发送给外部推理模型。
EXTERNAL_REASONING_DATA_MODE=disabled
# 将你的密钥仅写入本机 .env，绝不写进插件、HTML、JSON 交接包或浏览器存储。
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.2
ZHIPU_MAX_TOOL_ROUNDS=4
ZHIPU_TIMEOUT_SECONDS=45
